subgroup_gmt_plot <- function(dat){

  plot_subgroup_gmt_list <- list()

  for (antibody in  levels(dat$SARS.CoV.2)) {

    subset_data <- dat[dat$SARS.CoV.2 == antibody, ]

    stat_test <- subset_data %>%
      kruskal_test(Levels ~ Group) %>%
      add_xy_position(x = "Group")  %>%
      mutate(p.adj.signif = case_when(p.adj < 0.05 ~ "***",
                                      p.adj < 0.1 ~ "***",
                                      p.adj < 0.2 ~ "*",
                                      TRUE ~ ""
      )) %>%
      filter(p.adj < 0.2)

    p <- ggplot(subset_data, aes(x = Group, y = Levels, color = Group)) +
      geom_boxplot(
        width = 0.5,
        size = 1,
        alpha = 1,
        outlier.color = "grey95"
      ) +
      stat_pvalue_manual(
        stat_test,
        label = "p.adj.signif",
        tip.length = 0.01,
        step.increase = 0.1
      ) +
      geom_jitter(
        aes(color = Group),
        width = 0.1,
        size = 1,
        alpha = 0.5
      ) +
      scale_color_manual(values = c("#0073BD", "#24A535", "#9F6CB4"))+
      labs(title = "", x = "Group", y = "Log(GMT day 14)") +
      theme_classic() +
      theme(plot.title = element_text(
        hjust = 0.5,
        face = "bold",
        size = 12
      ),
      axis.text.y = element_text(face = "bold",color = "black",size = 10),
      axis.text.x = element_text(face = "bold",color = "black",size = 10, angle = 45, hjust = 1),
      axis.title.y = element_text(face = "bold",color = "black",size = 10),
      axis.title.x = element_blank(),
      legend.position = "none")

    plot_subgroup_gmt_list[[antibody]] <- p
  }

  (plot <- wrap_plots(plot_subgroup_gmt_list) + plot_layout(nrow = 2, guides = "collect"))
  return(plot)
}

