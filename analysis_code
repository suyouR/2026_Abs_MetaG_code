alpha_calculate <- function(data){
  alpha_diversity <- data.frame(row.names = rownames(data))
  (alpha_diversity$num_species <- specnumber(data))

  (alpha_diversity$shannon_species <- diversity(data,index = "shannon"))
  (alpha_diversity$simpson_species <- diversity(data,index = "simpson"))
  (alpha_diversity$inv_simpson_species <- diversity(data,index = "invsimpson"))
  return(alpha_diversity)
}

