feature_matrix_for_mediation <- cbind(dat_gmb_log, dat_path2_ha_log)

run_mediation_candidate <- function(feature, cytokine, GMT) {
  ids <- Reduce(
    intersect,
    list(
      dat_metadata_2_day14$ID,
      rownames(feature_matrix_for_mediation),
      rownames(dat_cytokines_day1_log),
      rownames(dat_cytokines_baseline_log),
      rownames(dat_GMT_day14_log),
      rownames(dat_GMT_baseline_log)
    )
  )

  model_data <- dat_metadata_2_day14[
    match(ids, dat_metadata_2_day14$ID),
    ,
    drop = FALSE
  ]
  model_data$x <- feature_matrix_for_mediation[ids, feature]
  model_data$m <- dat_cytokines_day1_log[ids, cytokine]
  model_data$y <- dat_GMT_day14_log[ids, GMT]
  model_data$ck_baseline <- dat_cytokines_baseline_log[ids, cytokine]
  model_data$gmt_baseline <- dat_GMT_baseline_log[ids, GMT]
  model_data <- model_data[complete.cases(model_data), , drop = FALSE]

  tryCatch({
    fit_m <- lm(
      m ~ x + Gender + Age + BMI + Vaccination + ck_baseline,
      data = model_data
    )
    fit_y <- lm(
      y ~ x + m + Gender + Age + BMI + Vaccination + gmt_baseline,
      data = model_data
    )
    set.seed(2025)
    fit_med <- mediation::mediate(
      fit_m,
      fit_y,
      sims = 999,
      treat = "x",
      mediator = "m",
      boot = TRUE
    )
    med_summary <- summary(fit_med)

    tibble::tibble(
      feature = feature,
      cytokine = cytokine,
      GMT = GMT,
      p_med = med_summary$n.avg.p,
      est_med = med_summary$n.avg,
      ci2.5_med = med_summary$n.avg.ci[1],
      ci97.5_med = med_summary$n.avg.ci[2],
      xy_beta = coef(summary(fit_y))["x", 1],
      xy_p = coef(summary(fit_y))["x", 4],
      xm_beta = coef(summary(fit_m))["x", 1],
      xm_p = coef(summary(fit_m))["x", 4],
      my_beta = coef(summary(fit_y))["m", 1],
      my_p = coef(summary(fit_y))["m", 4],
      total_beta = med_summary$tau.coef,
      total_p = med_summary$tau.p
    )
  }, error = function(e) {
    tibble::tibble(
      feature = feature,
      cytokine = cytokine,
      GMT = GMT,
      p_med = NA_real_,
      est_med = NA_real_,
      ci2.5_med = NA_real_,
      ci97.5_med = NA_real_,
      xy_beta = NA_real_,
      xy_p = NA_real_,
      xm_beta = NA_real_,
      xm_p = NA_real_,
      my_beta = NA_real_,
      my_p = NA_real_,
      total_beta = NA_real_,
      total_p = NA_real_
    )
  })
}

