run_interaction_model <- function(feature, GMT, ck_name) {
  ids <- Reduce(
    intersect,
    list(
      dat_metadata_2_day14$ID,
      rownames(feature_matrix_for_mediation),
      rownames(dat_cytokines_baseline_log),
      rownames(dat_GMT_day14_log),
      rownames(dat_GMT_baseline_log)
    )
  )
  model_data <- dat_metadata_2_day14[
    match(ids, dat_metadata_2_day14$ID),
    ,
    drop = FALSE
  ]
  model_data$x <- feature_matrix_for_mediation[ids, feature]
  model_data$m <- dat_cytokines_baseline_log[ids, ck_name]
  model_data$y <- dat_GMT_day14_log[ids, GMT]
  model_data$gmt_baseline <- dat_GMT_baseline_log[ids, GMT]
  fit <- lm(
    y ~ x * m + Gender + Age + BMI + Vaccination + gmt_baseline,
    data = model_data,
    na.action = na.exclude
  )
  coefficient_table <- coef(summary(fit))

  tibble::tibble(
    feature = feature,
    GMT = GMT,
    ck_name = ck_name,
    MetaF_beta = coefficient_table["x", 1],
    MetaF_sd = coefficient_table["x", 2],
    MetaF_p = coefficient_table["x", 4],
    IM_beta = coefficient_table["m", 1],
    IM_sd = coefficient_table["m", 2],
    IM_p = coefficient_table["m", 4],
    ia_beta = coefficient_table["x:m", 1],
    ia_sd = coefficient_table["x:m", 2],
    ia_p = coefficient_table["x:m", 4]
  )
}

