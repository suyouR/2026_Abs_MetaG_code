low.re.abundance.removal <- function(data,prevalence=0.1){
  removal.taxa <- which(rowSums(data>0.01)/ncol(data) <= prevalence)
  keep.taxa <- which(rowSums(data>0.01)/ncol(data) > prevalence)
  data.gmb.filtered <- data[keep.taxa,]
  return(list(data.gmb.filtered=data.gmb.filtered,
              keep.taxa=keep.taxa,
              removal.taxa=removal.taxa))
}

