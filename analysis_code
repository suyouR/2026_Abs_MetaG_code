safe_file_name <- function(x) {
  gsub("[^A-Za-z0-9._-]+", "_", x)
}

run_maaslin_outcomes <- function(
    feature_data,
    outcome_data,
    metadata,
    analysis_name,
    baseline_data = NULL,
    outcomes = colnames(outcome_data),
    covariates = c("Gender", "Age", "BMI", "Vaccination")) {
  feature_data <- as.data.frame(feature_data)
  outcome_data <- as.data.frame(outcome_data)
  metadata <- as.data.frame(metadata)

  purrr::map_dfr(outcomes, function(outcome) {
    ids <- intersect(as.character(metadata$ID), rownames(feature_data))
    ids <- intersect(ids, rownames(outcome_data))
    if (!is.null(baseline_data)) {
      ids <- intersect(ids, rownames(baseline_data))
    }

    model_metadata <- metadata[match(ids, metadata$ID), , drop = FALSE]
    model_metadata[[outcome]] <- outcome_data[ids, outcome, drop = TRUE]
    fixed_effects <- c(outcome, covariates)

    if (!is.null(baseline_data)) {
      model_metadata$baseline_value <- baseline_data[ids, outcome, drop = TRUE]
      fixed_effects <- c(outcome, "baseline_value", covariates)
    }

    rownames(model_metadata) <- model_metadata$ID
    model_output <- file.path(
      output_dir,
      "MaAsLin",
      analysis_name,
      safe_file_name(outcome)
    )
    dir.create(model_output, recursive = TRUE, showWarnings = FALSE)

    fit <- Maaslin2(
      input_data = feature_data[ids, , drop = FALSE],
      input_metadata = model_metadata,
      fixed_effects = fixed_effects,
      random_effects = NULL,
      plot_heatmap = FALSE,
      plot_scatter = FALSE,
      normalization = "NONE",
      transform = "NONE",
      min_abundance = 0,
      min_prevalence = 0,
      min_variance = 0,
      output = model_output
    )

    fit$results %>%
      dplyr::filter(metadata == outcome) %>%
      dplyr::mutate(
        qval = p.adjust(pval, method = "fdr"),
        outcome = outcome
      )
  })
}

run_diversity_associations <- function(
    diversity_data,
    outcome_data,
    metadata,
    baseline_data = NULL,
    outcomes = colnames(outcome_data),
    covariates = c("Gender", "Age", "BMI", "Vaccination"),
    family = gaussian()) {
  diversity_data <- as.data.frame(diversity_data)
  outcome_data <- as.data.frame(outcome_data)
  metadata <- as.data.frame(metadata)

  purrr::map_dfr(outcomes, function(outcome) {
    purrr::map_dfr(colnames(diversity_data), function(exposure) {
      ids <- intersect(as.character(metadata$ID), rownames(diversity_data))
      ids <- intersect(ids, rownames(outcome_data))
      if (!is.null(baseline_data)) {
        ids <- intersect(ids, rownames(baseline_data))
      }

      model_data <- metadata[match(ids, metadata$ID), , drop = FALSE]
      model_data$outcome_value <- outcome_data[ids, outcome, drop = TRUE]
      model_data$exposure_value <- diversity_data[ids, exposure, drop = TRUE]
      terms <- c("exposure_value", covariates)

      if (!is.null(baseline_data)) {
        model_data$baseline_value <- baseline_data[ids, outcome, drop = TRUE]
        terms <- c("exposure_value", "baseline_value", covariates)
      }

      fit <- glm(
        reformulate(terms, response = "outcome_value"),
        data = model_data,
        family = family,
        na.action = na.exclude
      )
      coefficient_table <- summary(fit)$coefficients

      tibble::tibble(
        x_variable = exposure,
        y_variable = outcome,
        coefficient = coefficient_table["exposure_value", 1],
        p_value = coefficient_table["exposure_value", 4]
      )
    })
  }) %>%
    dplyr::group_by(y_variable) %>%
    dplyr::mutate(FDR_p_value = p.adjust(p_value, method = "fdr")) %>%
    dplyr::ungroup()
}

