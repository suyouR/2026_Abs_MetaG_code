gmb_gmt_plot <- function(dat,
                         y_label = element_blank(),
                         fill_limits = fill_limits,
                         fill_breaks = fill_breaks,
                         x_title) {
  plot <- ggplot(dat, aes(x = outcome, y = feature_label)) +
    geom_tile(data = subset(dat, pval >= 0.05),
              fill = "white", color = "gray90", show.legend = FALSE) +
    geom_tile(data = subset(dat, pval < 0.05),
              aes(fill = coef), color = "gray90") +
    geom_text(aes(label = ifelse(qval < 0.05, "***",
                                 ifelse(qval < 0.1, "**",
                                        ifelse(qval < 0.2, "*", "")))),
              color = "black", size = 4) +
    scale_fill_gradient2(
      low = "#58B4E9", mid = "white", high = "firebrick3",
      midpoint = 0,
      limits = fill_limits,
      breaks = fill_breaks,
      oob = squish,
      name = "MaAsLin2 Coefficient"
    ) +
    theme_classic() +
    theme(
      panel.background = element_rect(color = "black", size = .5, fill = NA),
      panel.border = element_rect(color = "black", size = .5, fill = NA),
      legend.key.size = unit(.4, "cm"),
      legend.title = element_text(color = "black", face = "bold", size = 10),
      axis.title.x = element_text(color = "black", face = "bold", size = 10),
      axis.title.y = y_label,
      axis.text.x  = element_text(size = 10, color = "black", angle = 45, hjust = 1, face = "bold"),
      axis.text.y  = y_label,
      plot.title = element_blank()
    ) +
    labs(x = x_title, y = "Metagenomic Species")
  return(plot)
}

