prepare_species_results <- function(model_results, outcome_levels, feature_levels = NULL) {
  prepared <- model_results %>%
    dplyr::select(feature, outcome, coef, qval, pval) %>%
    dplyr::filter(feature %in% name_all_gmb_sig) %>%
    dplyr::mutate(
      feature_label = sub("_", " ", sub("s__", "", feature)),
      outcome = factor(outcome, levels = outcome_levels)
    )

  if (is.null(feature_levels)) {
    feature_levels <- prepared %>%
      dplyr::group_by(feature_label) %>%
      dplyr::summarise(total_coef = sum(coef), .groups = "drop") %>%
      dplyr::arrange(dplyr::desc(total_coef)) %>%
      dplyr::pull(feature_label)
  }

  prepared %>%
    dplyr::mutate(
      feature = factor(feature, levels = unique(feature)),
      feature_label = factor(feature_label, levels = feature_levels)
    )
}

