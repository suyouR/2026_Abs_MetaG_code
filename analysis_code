beta_calculate <- function(data){
  bray_gmb<-vegdist(data,method="bray", na.rm = T)
  bray_gmb<-as.matrix(bray_gmb)

  pCoa_gmb <- cmdscale( bray_gmb, eig = T,k = 3 )

  varExp_gmb <- (eigenvals(pCoa_gmb)/sum(eigenvals(pCoa_gmb)))[1:3]
  xVar_gmb <- as.numeric(varExp_gmb[1]*100)
  yVar_gmb <- as.numeric(varExp_gmb[2]*100)
  zVar_gmb <- as.numeric(varExp_gmb[3]*100)

  pCoaVecs_gmb <- as.data.frame(pCoa_gmb$points)
  pCoaVecsDF_gmb <- cbind.data.frame(data.frame(PCoA=c(1:3)),data.frame(VarExplained=varExp_gmb))
  pCoaVecs_gmb$ID <- row.names(pCoaVecs_gmb)

  pCoaVecs_gmb <- subset(pCoaVecs_gmb, select = -ncol(pCoaVecs_gmb))
  return(list(pCoaVecs_gmb, xVar_gmb, yVar_gmb, bray_gmb))
  print('pCoaVecs_gmb, xVar_gmb, yVar_gmb, bray_gmb')
}

