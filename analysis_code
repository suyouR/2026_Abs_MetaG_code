LM_gmb_gmt <- function(df_diversity, data_gmt, data_metadata, ytitle = "Species Diversity Indicators",
                       formule = as.formula(paste0("outcome ~ exposure + gmt_baseline + Gender + Age + BMI + Vaccination"))
)
                       {

  df_diversity <- as.data.frame(df_diversity)

  result_diversity_gmt <- data.frame(
    x_variable = character(),
    y_variable = character(),
    coefficient = numeric(),
    p_value = numeric(),
    stringsAsFactors = FALSE
  )

  for (outcome in colnames(data_gmt)) {

    for (exposure in colnames(df_diversity)) {

      metadata <- cbind(outcome = data_gmt[data_metadata$ID, outcome, drop = FALSE],
                        diversity_dat = df_diversity[data_metadata$ID, exposure],
                        gmt_baseline = dat_GMT_baseline_log[data_metadata$ID, outcome],
                        data_metadata)

      colnames(metadata)[1] <- "outcome"
      colnames(metadata)[2] <- "exposure"

      model <- glm(formule,
                   na.action = na.exclude, data = metadata)

      coef_val <- summary(model)$coefficients[2, 1]
      p_val <- summary(model)$coefficients[2, 4]

      result_diversity_gmt <- rbind(result_diversity_gmt, data.frame(x_variable = exposure,
                                                                     y_variable = outcome,
                                                                     coefficient = coef_val,
                                                                     p_value = p_val))
    }
  }

  result_diversity_gmt$FDR_p_value <- NA

  for (y in unique(result_diversity_gmt$y_variable)) {

    subset_results <- result_diversity_gmt[result_diversity_gmt$y_variable == y, ]

    result_diversity_gmt$FDR_p_value[result_diversity_gmt$y_variable == y] <- p.adjust(subset_results$p_value, method = "fdr")
  }

  result_diversity_gmt <- result_diversity_gmt %>%
    mutate(y_variable = factor(y_variable, levels = colnames(data_gmt)),
           x_variable = factor(x_variable, levels = rev(c("Richness", "Shannon Index", "Simpson Index", "PCo1", "PCo2", "PCo3")
           )
           )
    )

  (correlation_diversity_gmt_day14 <- ggplot(result_diversity_gmt, aes(x = y_variable, y = x_variable)) +

      geom_point(

        aes(size = -log10(FDR_p_value)),
        shape = 21, fill = "grey80", color = "white", show.legend = FALSE
      ) +

      geom_point(
        data = subset(result_diversity_gmt, FDR_p_value < 0.2),
        aes(fill = coefficient, size = -log10(FDR_p_value)),
        shape = 21, color = "white"
      ) +

      scale_fill_gradient2(
        low = "#58B4E9",
        mid = "white",
        high = "firebrick3",
        midpoint = 0,
      ) +
      scale_size(name = expression(-log[10](FDR~p)),
                 range = c(2, 6),
                 guide = guide_legend(
                   override.aes = list(
                     shape = 21,
                     fill  = "#58B4E9",
                     color = "white"
                   )
                 )) +
      theme_classic()+
      theme(
        panel.background = element_blank(),
        panel.border = element_rect(color = "black", size = .5, fill = NA),
        axis.title.x = element_text(size = 10, color = "black", face = "bold"),
        axis.title.y = element_text(size = 10, color = "black", face = "bold"),
        axis.text.x =  element_text(size = 10, color = "black", face = "bold", angle = 45, hjust = 1),
        axis.text.y = element_text(size = 10, color = "black", face = "bold"),
        legend.title = element_text(size = 10, color = "black", face = "bold"),
        panel.grid.major = element_line(color = "gray90"),
        plot.title = element_blank()
      ) +
      labs(
        title = "",
        x = "Neutralizing Antibodies",
        y = ytitle,
        size = "-Log10(FDR P)",
        fill = "Linear Regression Coefficient"
      ))

  return(list(result_diversity_gmt, correlation_diversity_gmt_day14))
}

