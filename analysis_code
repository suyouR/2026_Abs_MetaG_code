correlation_analysis_psych <- function(df1, df2) {

  cor_results <- corr.test(df1, df2, adjust = "none", method = "spearman")

  results <- data.frame(
    x = rep(colnames(df1), each = ncol(df2)),
    y = rep(colnames(df2), times = ncol(df1)),
    coef = as.vector(cor_results$r),
    p = as.vector(cor_results$p)
  )

  return(results)
}

